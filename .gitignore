__pycache__/
*.py[cod]
.venv/
venv/
.env

# Generated outputs — regenerated by the CLI
runs/
data/warehouse/*
!data/warehouse/.gitkeep
work/*
!work/.gitkeep

# Upstream export drops. These are live business data and must never be
# committed; regenerate test copies with tests/make_export_fixtures.py.
data/drop/*
!data/drop/.gitkeep

# Local Excel debris
~$*
*.tmp

# discovery/ and queries/ ARE committed on purpose: the manifest and the
# extracted M code are the version-controlled record of the estate, and a
# query change that breaks the pipeline has to show up in a diff.
